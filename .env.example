# ============================================================
#  部署配置模板
#  用法:cp .env.example .env 然后修改下面标了 CHANGE_ME 的两项
#  也可以直接运行 bash deploy.sh,它会自动生成随机密码与密钥
# ============================================================

# ---------- 对外访问端口 ----------
# 云服务器安全组必须放行这个 TCP 端口
APP_PORT=8080

# ---------- 数据库 ----------
# 务必改成自己的强密码(16 位以上,字母+数字+符号)
MYSQL_ROOT_PASSWORD=CHANGE_ME_to_a_strong_password
# 库名保持默认:db/schema.sql 里硬编码了 campus_second_hand,改了会建表失败
DB_NAME=campus_second_hand

# ---------- JWT ----------
# HS256 要求密钥长度 >= 32 字节。建议直接用 deploy.sh 自动生成,
# 不要用仓库里的示例值上线,否则任何人都能伪造 Token
JWT_SECRET=CHANGE_ME_to_a_random_string_at_least_32_chars
JWT_EXPIRATION=86400

# ---------- JVM 内存 ----------
# deploy.sh 会按物理内存自动覆盖下面这一整组参数,一般无需手改。
# 想先看脚本会用什么值:  bash deploy.sh tune
#   1G 机型  → -Xms96m -Xmx192m -XX:MaxMetaspaceSize=128m -XX:+UseSerialGC
#              -XX:TieredStopAtLevel=1(只用 C1 编译,启动快、代码缓存省)
#   2G 机型  → -Xms128m -Xmx384m -XX:MaxMetaspaceSize=192m -XX:+UseSerialGC
#   4G 机型  → -Xms256m -Xmx768m
#   8G 以上  → -Xms512m -Xmx1536m
JAVA_OPTS=-Xms96m -Xmx192m -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=48m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8

# ---------- 容器内存上限 ----------
# 防止某一个容器失控把整台机器拖死:超限只杀该容器
# 1G → 400m / 440m    2G → 800m / 700m    4G → 1500m / 1280m
# 下面给的是 1G 档的安全值,跑 deploy.sh 会按实际内存自动改成合适的
MYSQL_MEM_LIMIT=400m
APP_MEM_LIMIT=440m

# ---------- MySQL 缓冲池 ----------
# 1G → 64M(32M chunk)   2G → 128M   4G → 256M   8G+ → 512M
MYSQL_BUFFER_POOL=64M
MYSQL_BUFFER_POOL_CHUNK=32M

# ---------- 并发上限 ----------
# 小机器上线程和连接都要收窄:每个 Tomcat 线程预留约 1MB 栈,
# 每个 MySQL 连接在服务端也占内存。1G → 30 线程 / 3 连接 / 50 最大连接
TOMCAT_MAX_THREADS=30
DB_POOL_SIZE=3
MYSQL_MAX_CONN=50
MYSQL_TABLE_CACHE=64

# ---------- 镜像构建方式 ----------
# Dockerfile.jar = 只跑本地打好的 jar,不编译(1G/2G 机型必需,10 秒构建)
# Dockerfile     = 在服务器上完整编译(需 4G 内存,3-8 分钟)
# deploy.sh 会自动检测 target/*.jar 并选好,一般无需手改
DOCKERFILE=Dockerfile.jar

# ---------- Docker 镜像加速(可选) ----------
# 阿里云 ECS:加速地址是账号专属的,到「容器镜像服务 → 镜像工具 → 镜像加速器」复制
#   然后: DOCKER_MIRROR=https://xxxxxx.mirror.aliyuncs.com bash deploy.sh
# 腾讯云:脚本会自动识别并配置 mirror.ccs.tencentyun.com,无需设置
# DOCKER_MIRROR=
